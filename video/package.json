{
  "name": "portfolio-showreel",
  "private": true,
  "version": "0.0.0",
  "description": "Portfolio showcase asset generator — Playwright captures, stepped-scroll Remotion films, ffmpeg delivery.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:showreel": "remotion render src/index.ts Showreel out/showreel.mp4 --codec=h264",
    "render": "node scripts/render.mjs",
    "render:webm": "remotion render src/index.ts Showreel out/showreel.webm --codec=vp9",
    "capture": "node scripts/capture.mjs",
    "discover": "node scripts/discover-routes.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
